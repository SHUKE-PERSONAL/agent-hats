#!/usr/bin/env bash
# hat <mode> [NICK] [--kind K] [--backend NICK] [--model M] [--effort E] [--] [agent args...]
# Provision the per-mode, per-kind config home, install the mode's
# constitution as the kind's prompt file, and exec the agent CLI. Extra args
# pass through to the agent. Each option falls back to its HAT_*
# variable; the flag wins over the variable.
set -euo pipefail

die()  { printf 'hat: %s\n' "$*" >&2; exit 1; }
warn() { printf 'hat: %s\n' "$*" >&2; }
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage="usage: hat <mode> [<nickname>] [--kind <claude|copilot>] [--backend <nickname>] [--model <model>] [--effort <effort>] [--] [agent args...]"
# A mode is any ~/.agent-hats/<mode>.md; the name must be a plain file stem.
mode="${1:-}"
case "$mode" in
  ""|-*) die "$usage" ;;
esac
[[ "$mode" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "invalid mode '$mode': use letters, digits, '-' and '_'"
shift

# Launcher options are recognised only before the first agent argument, which
# is where `hat explore --kind copilot` puts them; everything from there passes
# through. A first bare word names the backend (`hat live ccz` =
# `hat live --backend ccz`) unless --backend is already given; a later bare
# word, or `--`, starts the agent args.
kind="${HAT_KIND:-}"
backend="${HAT_BACKEND:-}"
model="${HAT_MODEL:-}"
effort="${HAT_EFFORT:-}"
backend_arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    --kind|--backend|--model|--effort)
      [ $# -ge 2 ] || { [ "$1" = --kind ] && die "--kind needs a value; accepted values: claude, copilot"; die "$1 needs a value"; }
      printf -v "${1#--}" '%s' "$2"; [ "$1" = --backend ] && backend_arg=1; shift 2 ;;
    --kind=*|--backend=*|--model=*|--effort=*)
      opt="${1%%=*}"; [ -n "${1#*=}" ] || die "$opt needs a value"; printf -v "${opt#--}" '%s' "${1#*=}"
      [ "$opt" = --backend ] && backend_arg=1; shift ;;
    --) shift; break ;;
    -*) break ;;
    *) [ -z "$backend_arg" ] || break
       backend="$1" backend_arg=1; shift ;;
  esac
done
case "$kind" in
  ''|claude|copilot) ;;
  *) die "unknown kind '$kind'; accepted values: claude, copilot" ;;
esac

# A backend nickname is looked up in agent-hats' own table, then mat's;
# only nickname, kind, default_model, default_effort, auth_var, base_url_var
# and context_window_size are read.
# Both files are optional and read-only: without jq, or with no readable
# table, the built-in defaults apply. A nickname missing from every readable
# table is an error.
auth_var="" base_url_var="" context_window_size=""
if [ -n "$backend" ]; then
  tables=0 entry=""
  if ! command -v jq >/dev/null 2>&1; then
    warn "jq not found; backend '$backend' not resolved, using built-in defaults"
  else
    for table in "$HOME/.agent-hats/backends.json" "$HOME/.config/mat/backends.json"; do
      [ -e "$table" ] || continue
      if ! jq -e '.backends | type == "array"' "$table" >/dev/null 2>&1; then
        warn "ignoring unreadable or malformed $table"
        continue
      fi
      tables=$((tables + 1))
      # tr: native jq on Windows emits CRLF.
      entry="$(jq -r --arg n "$backend" 'first(.backends[] | objects | select(.nickname == $n))
        | (.kind // ""), (.default_model // ""), (.default_effort // ""), (.auth_var // ""), (.base_url_var // ""), (.context_window_size // "" | tostring)' "$table" 2>/dev/null | tr -d '\r')" || entry=""
      [ -n "$entry" ] && break
    done
    if [ -n "$entry" ]; then
      { read -r entry_kind; read -r entry_model; read -r entry_effort; read -r auth_var; read -r base_url_var; read -r context_window_size; } <<<"$entry" || true  # $(...) drops trailing empty fields
      if [ -n "$entry_kind" ]; then
        case "$entry_kind" in
          claude|copilot) ;;
          *) die "backend '$backend' has kind '$entry_kind'; accepted values: claude, copilot" ;;
        esac
        [ -z "$kind" ] || [ "$kind" = "$entry_kind" ] \
          || die "backend '$backend' has kind '$entry_kind', but kind '$kind' was requested"
        kind="$entry_kind"
      fi
      [ -n "$model" ]  || model="$entry_model"
      [ -n "$effort" ] || effort="$entry_effort"
    elif [ "$tables" -gt 0 ]; then
      die "unknown backend '$backend': not found in ~/.agent-hats/backends.json or ~/.config/mat/backends.json"
    else
      warn "no readable backends.json; backend '$backend' not resolved, using built-in defaults"
    fi
  fi
fi
kind="${kind:-claude}"
case "$kind" in
  claude)  : "${model:=opus[1m]}" "${effort:=medium}" ;;
  copilot) : "${model:=gpt-5.5}" "${effort:=medium}" ;;
esac

src="$HOME/.agent-hats/$mode.md"
[ -f "$src" ] || die "constitution not found: $src"

command -v "$kind" >/dev/null 2>&1 || die "$kind not found on PATH"

home="$HOME/.agent-hats/homes/$mode-$kind"

# Copilot's token precedence is COPILOT_GITHUB_TOKEN > GH_TOKEN > GITHUB_TOKEN;
# fall back to the gh CLI's OAuth token. Copilot rejects classic PATs, so a
# ghp_ token is refused here rather than launching into a login failure.
copilot_token() {
  local var token=""
  for var in COPILOT_GITHUB_TOKEN GH_TOKEN GITHUB_TOKEN; do
    token="${!var:-}"
    [ -n "$token" ] && break
  done
  if [ -z "$token" ]; then
    var="gh auth token"
    token="$(gh auth token 2>/dev/null || true)"
  fi
  [ -n "$token" ] || die "no GitHub token for Copilot: set COPILOT_GITHUB_TOKEN (or GH_TOKEN / GITHUB_TOKEN), or log in with 'gh auth login'"
  case "$token" in
    ghp_*) die "$var holds a classic PAT (ghp_...); Copilot requires a fine-grained PAT or a gh OAuth token" ;;
  esac
  printf '%s' "$token"
}

# Copilot blocks startup on a folder-trust modal unless the working directory
# is under an entry of trustedFolders in $COPILOT_HOME/config.json; no flag
# (not even --yolo) skips it. Seed the cwd, keeping Copilot's leading //
# header lines, which jq cannot parse.
copilot_trust_cwd() {
  local cfg="$home/config.json" dir header body
  dir="$PWD"
  command -v cygpath >/dev/null 2>&1 && dir="$(cygpath -w "$dir")"
  if ! command -v jq >/dev/null 2>&1; then
    printf 'hat: jq not found; folder trust not pre-seeded, Copilot will ask once to trust %s\n' "$dir" >&2
    return 0
  fi
  header="" body="{}"
  if [ -s "$cfg" ]; then
    header="$(awk '/^[[:space:]]*\/\//{print; next} {exit}' "$cfg")"
    body="$(awk 'f{print; next} /^[[:space:]]*(\/\/|$)/{next} {f=1; print}' "$cfg")"
  fi
  printf '%s' "$body" | jq -e --arg d "$dir" '(.trustedFolders // []) | index($d)' >/dev/null 2>&1 && return 0
  body="$(printf '%s' "$body" | jq --arg d "$dir" '.trustedFolders = ((.trustedFolders // []) + [$d])')" \
    || die "cannot update folder trust in $cfg (not valid JSON?)"
  { [ -n "$header" ] && printf '%s\n' "$header"; printf '%s\n' "$body"; } > "$cfg.tmp"
  mv -f "$cfg.tmp" "$cfg"
}

# seed_json <file> <filter> [jq args...]: apply an idempotent jq update to a
# JSON file (absent counts as {}), rewriting it only when the update changes it.
seed_json() {
  local file="$1" filter="$2" body="{}"
  shift 2
  [ -s "$file" ] && body="$(<"$file")"
  printf '%s' "$body" | jq -e "$@" "($filter) == ." >/dev/null 2>&1 && return 0
  printf '%s' "$body" | jq "$@" "$filter" > "$file.tmp" \
    || { rm -f "$file.tmp"; die "cannot update $file (not valid JSON?)"; }
  mv -f "$file.tmp" "$file"
}

# A fresh Claude home stops on onboarding (theme and login), the folder-trust
# dialog and the bypass-permissions warning. Pre-answer all three, and point
# the status line at bin/hat-statusline unless the home has its own. Claude
# keys folder trust by the git common root (the main checkout, also for a
# worktree), else the cwd, in Windows mixed form (C:/...).
claude_seed_home() {
  local dir="$PWD" common
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" && dir="$(dirname "$common")"
  command -v cygpath >/dev/null 2>&1 && dir="$(cygpath -m "$dir")"
  if ! command -v jq >/dev/null 2>&1; then
    warn "jq not found; folder trust not pre-seeded, Claude will ask once to trust $dir"
    [ -e "$home/.claude.json" ] || printf '{"hasCompletedOnboarding": true}\n' > "$home/.claude.json"
    [ -e "$home/settings.json" ] || printf '{"skipDangerousModePermissionPrompt": true}\n' > "$home/settings.json"
    return 0
  fi
  seed_json "$home/.claude.json" '.hasCompletedOnboarding = true
    | .projects[$d] = ({allowedTools: []} + (.projects[$d] // {}) + {hasTrustDialogAccepted: true})' --arg d "$dir"
  local statusline="$here/hat-statusline"
  command -v cygpath >/dev/null 2>&1 && statusline="$(cygpath -m "$statusline")"
  seed_json "$home/settings.json" '.skipDangerousModePermissionPrompt = true
    | if (.statusLine == null) or ((.statusLine.command // "") | test("hat-statusline"))
      then .statusLine = {type: "command", command: ("bash \"" + $s + "\"")} else . end' --arg s "$statusline"
}

# Claude authenticates with a `claude setup-token` token, read from the
# backend's auth_var or CLAUDE_CODE_OAUTH_TOKEN and exported as
# ANTHROPIC_AUTH_TOKEN, because CLAUDE_CODE_OAUTH_TOKEN loses to a stale
# .credentials.json in the home. Without one, Claude uses whatever other auth
# it finds (API key, cloud provider, or a /login stored in the home). A
# backend's base_url_var names its endpoint (a third-party Anthropic-compatible
# API); an unset one stops the launch so its key never goes to Anthropic.
claude_auth() {
  local var="${auth_var:-CLAUDE_CODE_OAUTH_TOKEN}"
  [[ "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "backend '$backend' has invalid auth_var '$var'"
  if [ -n "$base_url_var" ]; then
    [[ "$base_url_var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "backend '$backend' has invalid base_url_var '$base_url_var'"
    [ -n "${!base_url_var:-}" ] || die "backend '$backend' needs its endpoint in $base_url_var, which is not set"
    export ANTHROPIC_BASE_URL="${!base_url_var}"
  fi
  if [ -n "${!var:-}" ]; then
    export ANTHROPIC_AUTH_TOKEN="${!var}"
    unset CLAUDE_CODE_OAUTH_TOKEN
  elif [ -z "${ANTHROPIC_AUTH_TOKEN:-}${ANTHROPIC_API_KEY:-}" ]; then
    warn "$var is not set; Claude will ask you to log in (run 'claude setup-token' and export $var to skip that)"
  fi
}

# Claude compacts the conversation once it holds this many tokens. A backend's
# context_window_size (an integer, optionally with a k or m suffix) sets it;
# otherwise 256000, well below the 1M window, so each turn stays small.
compact_window() {
  local raw="$context_window_size" n
  if [ -z "$raw" ]; then echo 256000; return; fi
  if [[ "$raw" =~ ^([0-9]+)([kKmM]?)$ ]]; then
    n=$((10#${BASH_REMATCH[1]}))
    case "${BASH_REMATCH[2]}" in
      k|K) n=$((n * 1000)) ;;
      m|M) n=$((n * 1000000)) ;;
    esac
    if [ "$n" -gt 0 ]; then echo "$n"; return; fi
  fi
  warn "backend '$backend' has invalid context_window_size '$raw'; using 256000"
  echo 256000
}

# Skills: the hat's own, under skills/<mode>/ in this checkout, are copied
# afresh on every launch. The live hat also links each personal skill from the
# kind's default home ($1), never replacing a skill the hat home already has.
seed_skills() {
  local personal="$1" dir name
  mkdir -p "$home/skills"
  for dir in "$(dirname "$here")/skills/$mode"/*/; do
    dir="${dir%/}"
    [ -f "$dir/SKILL.md" ] || continue
    name="$(basename "$dir")"
    rm -rf "$home/skills/$name"
    cp -R "$dir" "$home/skills/$name"
  done
  [ "$mode" = live ] && [ -d "$personal" ] || return 0
  for dir in "$personal"/*/; do
    dir="${dir%/}"
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    if [ -e "$home/skills/$name" ] || [ -L "$home/skills/$name" ]; then continue; fi
    ln -s "$dir" "$home/skills/$name"
  done
}

case "$kind" in
  claude)
    mkdir -p "$home"
    # Copy (never symlink) on every launch so source edits apply on next start.
    cp -f "$src" "$home/CLAUDE.md"
    claude_seed_home
    seed_skills "$HOME/.claude/skills"
    claude_auth
    export CLAUDE_CONFIG_DIR="$home"
    CLAUDE_CODE_AUTO_COMPACT_WINDOW="$(compact_window)"
    export CLAUDE_CODE_AUTO_COMPACT_WINDOW
    exec claude "--model=$model" --effort "$effort" --dangerously-skip-permissions "$@"
    ;;
  copilot)
    token="$(copilot_token)" || exit 1
    mkdir -p "$home"
    cp -f "$src" "$home/copilot-instructions.md"
    copilot_trust_cwd
    seed_skills "$HOME/.copilot/skills"
    export COPILOT_HOME="$home"
    export COPILOT_SETUP_TERMINAL=false
    export COPILOT_GITHUB_TOKEN="$token"
    exec copilot --yolo --model "$model" --effort "$effort" "$@"
    ;;
esac
