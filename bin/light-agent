#!/usr/bin/env bash
# light-agent <mode> [--kind <claude|copilot>] [agent args...]
# Provision the per-mode, per-kind config home, install the mode's
# constitution as the kind's prompt file, and exec the agent CLI. Extra args
# pass through to the agent. The kind defaults to $LIGHT_AGENT_KIND, then
# claude; --kind wins over the variable.
set -euo pipefail

die() { printf 'light-agent: %s\n' "$*" >&2; exit 1; }

usage="usage: light-agent <explore|live|adhoc> [--kind <claude|copilot>] [agent args...]"
mode="${1:-}"
case "$mode" in
  explore) prefix=lme ;;
  live)    prefix=lml ;;
  adhoc)   prefix=lma ;;
  *) die "$usage" ;;
esac
shift

# --kind is recognised only as the first argument after the mode, which is
# where `lme --kind copilot` puts it; everything after passes through.
kind="${LIGHT_AGENT_KIND:-claude}"
case "${1:-}" in
  --kind)   [ $# -ge 2 ] || die "--kind needs a value; accepted values: claude, copilot"; kind="$2"; shift 2 ;;
  --kind=*) kind="${1#--kind=}"; shift ;;
esac
case "$kind" in
  claude|copilot) ;;
  *) die "unknown kind '$kind'; accepted values: claude, copilot" ;;
esac

src="$HOME/.light-agents/$mode.md"
[ -f "$src" ] || die "constitution not found: $src"

command -v "$kind" >/dev/null 2>&1 || die "$kind not found on PATH"

home="$HOME/.mat-agent-home/$prefix-$kind"

# Copilot's token precedence is COPILOT_GITHUB_TOKEN > GH_TOKEN > GITHUB_TOKEN;
# fall back to the gh CLI's OAuth token. Copilot rejects classic PATs, so a
# ghp_ token is refused here rather than launching into a login failure.
copilot_token() {
  local var token=""
  for var in COPILOT_GITHUB_TOKEN GH_TOKEN GITHUB_TOKEN; do
    token="${!var:-}"
    [ -n "$token" ] && break
  done
  if [ -z "$token" ]; then
    var="gh auth token"
    token="$(gh auth token 2>/dev/null || true)"
  fi
  [ -n "$token" ] || die "no GitHub token for Copilot: set COPILOT_GITHUB_TOKEN (or GH_TOKEN / GITHUB_TOKEN), or log in with 'gh auth login'"
  case "$token" in
    ghp_*) die "$var holds a classic PAT (ghp_...); Copilot requires a fine-grained PAT or a gh OAuth token" ;;
  esac
  printf '%s' "$token"
}

# Copilot blocks startup on a folder-trust modal unless the working directory
# is under an entry of trustedFolders in $COPILOT_HOME/config.json; no flag
# (not even --yolo) skips it. Seed the cwd, keeping Copilot's leading //
# header lines, which jq cannot parse.
copilot_trust_cwd() {
  local cfg="$home/config.json" dir header body
  dir="$PWD"
  command -v cygpath >/dev/null 2>&1 && dir="$(cygpath -w "$dir")"
  if ! command -v jq >/dev/null 2>&1; then
    printf 'light-agent: jq not found; folder trust not pre-seeded, Copilot will ask once to trust %s\n' "$dir" >&2
    return 0
  fi
  header="" body="{}"
  if [ -s "$cfg" ]; then
    header="$(awk '/^[[:space:]]*\/\//{print; next} {exit}' "$cfg")"
    body="$(awk 'f{print; next} /^[[:space:]]*(\/\/|$)/{next} {f=1; print}' "$cfg")"
  fi
  printf '%s' "$body" | jq -e --arg d "$dir" '(.trustedFolders // []) | index($d)' >/dev/null 2>&1 && return 0
  body="$(printf '%s' "$body" | jq --arg d "$dir" '.trustedFolders = ((.trustedFolders // []) + [$d])')" \
    || die "cannot update folder trust in $cfg (not valid JSON?)"
  { [ -n "$header" ] && printf '%s\n' "$header"; printf '%s\n' "$body"; } > "$cfg.tmp"
  mv -f "$cfg.tmp" "$cfg"
}

case "$kind" in
  claude)
    mkdir -p "$home"
    # Copy (never symlink) on every launch so source edits apply on next start.
    cp -f "$src" "$home/CLAUDE.md"
    export CLAUDE_CONFIG_DIR="$home"
    export CLAUDE_CODE_AUTO_COMPACT_WINDOW=256000
    exec claude '--model=opus[1m]' --effort medium --dangerously-skip-permissions "$@"
    ;;
  copilot)
    token="$(copilot_token)" || exit 1
    mkdir -p "$home"
    cp -f "$src" "$home/copilot-instructions.md"
    copilot_trust_cwd
    export COPILOT_HOME="$home"
    export COPILOT_SETUP_TERMINAL=false
    export COPILOT_GITHUB_TOKEN="$token"
    exec copilot --yolo --model gpt-5.5 --effort medium "$@"
    ;;
esac
